/target/
# Release packaging output (scripts/release/package.sh) and per-platform
# extension staging (scripts/release/build-extensions.sh).
/dist/
/ext-dist/
# Local dev services (`make console`): store, pid file and log.
/.dev/
*.pink
!crates/pinkdb/tests/fixtures/*.pink
# Lake fixture data files (their catalog/snapshot JSONs are tracked normally).
!crates/pink-lake/tests/fixtures/**/*.pink
*.csv
.DS_Store
__pycache__/
*.swp

# C extension SDK build outputs (the C++ SDK has its own build/ directory)
/ext-sdk/c/build/
/ext-sdk/c/template/build/
/ext-sdk/c/template/my_extension.dylib
/ext-sdk/c/template/my_extension.so
/ext-sdk/cpp/build/

# Go extension SDK build outputs
/ext-sdk/go/build/
/ext-sdk/go/template/build/

# C ABI example binary (built by the README recipe)
/crates/pinkdb-ffi/hello

# Rust extension SDK build outputs (the skeleton is a standalone crate)
/ext-sdk/rust/template/target/
/ext-sdk/rust/template/Cargo.lock

# In-repo extension build outputs (copied into build/ by extensions/*/Makefile
# for the publish workflow; the canonical libraries live in target/)
/extensions/*/build/

# The console browser app (wave 121) is outside the workspace: its own build dir.
crates/pinkdb-server-ui-web/target/
